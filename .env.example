GEMINI_API_KEY=your_gemini_api_key

LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional tuning
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=60000
# GEMINI_MAX_RETRIES=2
# LOG_LEVEL=INFO
# INVESTIGATE_RATE_LIMIT=10

# --- RCA answer generation provider: "gemini" or "openai" ---
# LLM_PROVIDER=gemini
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TIMEOUT_MS=60000
# OPENAI_MAX_RETRIES=2
# LLM_BACKOFF_BASE_SECONDS=1.0
# LLM_BACKOFF_MAX_SECONDS=30
# LLM_QUOTA_COOLDOWN_SECONDS=900

# Retrieval relevance (calibrated with evals/calibrate_retrieval.py)
# MIN_RELEVANCE_SCORE=0.60
# RELEVANCE_MARGIN=0.10
# STRONG_RELEVANCE_SCORE=0.75

# --- Authentication (backend/utils/auth.py, backend/security/) ---
# enforced (default; "api_key" is an alias): browser users sign in (HttpOnly
# session cookie) and service accounts use API keys. With neither a user nor a
# key configured, protected endpoints answer 503 (fail-closed).
# disabled: local development only (unauthenticated, logged as a warning).
# AUTH_MODE=enforced
# Browser users: cd backend && python -m security.users add alice --role investigator
# USERS_FILE=backend/storage/users.json
# SESSION_TTL_MINUTES=480
# SESSION_IDLE_MINUTES=60
# SESSION_COOKIE_SECURE=true
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# Service accounts: name:role:sha256[:tenant[:svc1|svc2]]
#   create with:  cd backend && python -m utils.auth new ci-bot viewer default payroll-service
# API_KEYS=
# Resource / tenant policy (which services each tenant owns; runbook mapping)
# ACCESS_POLICY_FILE=backend/security/access_policy.json
# AUDIT_DIR=backend/storage/audit

# --- PII protection: presidio (default) | regex | off ---
# PII_ENGINE=presidio
# PII_SPACY_MODEL=en_core_web_sm

# --- NeMo Guardrails: nemo (default) | off (only the exact value "off" disables them) ---
# GUARDRAILS_MODE=nemo
# Extra LLM self-check on the input rail (through LLM_PROVIDER; ~1 s per question).
# Fails closed: if it cannot give a verdict, the question is declined.
# GUARDRAILS_LLM_SELF_CHECK=true
# Wall-clock limit per rail call (seconds); an input rail that overruns declines the request
# GUARDRAILS_TIMEOUT_SECONDS=30

# --- Tools and approvals (simulated remediation only) ---
# REMEDIATION_MODE=simulated
# APPROVAL_PENDING_TTL_MINUTES=60
# APPROVAL_VALID_MINUTES=15
# APPROVALS_FILE=backend/storage/approvals.json

# --- Local MCP server (stdio only): services the local read-only identity may read ---
# MCP_TENANT=default
# MCP_SERVICES=

# --- Claim-support verifier: nli (default) | deterministic | off ---
# CLAIM_VERIFIER=nli
# CLAIM_VERIFIER_MODEL=cross-encoder/nli-deberta-v3-xsmall

# --- Structured (JSON) logs with request/investigation IDs ---
# LOG_FORMAT=json
