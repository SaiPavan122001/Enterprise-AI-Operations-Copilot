# API base path. Default "/api": same-origin, proxied to the backend (vite.config.js
# in development; your reverse proxy in production) so the session cookie works.
# VITE_API_URL=/api

# Backend address used by the Vite dev proxy.
# VITE_BACKEND_URL=http://127.0.0.1:8000

# There is NO API key setting for the browser any more: users sign in
# (backend: python -m security.users add <name> --role investigator).
